# Opcional: URL real de la mesa de servicios, cuando el equipo la tenga lista.
# Si está vacía, el portal muestra una guía para solicitar soporte.
VITE_HELPDESK_URL=
VITE_AUTH_ENABLED=false
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=intranet
# client = roles del cliente; realm = roles del realm. Respeta mayúsculas ADMIN/EMPLEADO.
VITE_KEYCLOAK_ROLE_SOURCE=client
VITE_KEYCLOAK_ROLE_CLIENT_ID=intranet
# URLs absolutas HTTPS. Rutas /api/... solo si existe un proxy en el mismo origen.
VITE_MESSAGE_READ_URL=
VITE_MESSAGE_WRITE_URL=
VITE_MESSAGE_WRITE_METHOD=PUT

# Solo para compose.ubuntu.yaml: IP que realmente tenga tu VM en la red del proyecto.
# No cambia la IP de Ubuntu; solo selecciona en qué interfaz publica Docker.
LAB_BIND_IP=127.0.0.1
